<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../VelleVersion.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>velle</ToolCommandName>
    <Description>Install Velle CSS components and browser behaviors into a project.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/codedbyshoe/velle-css</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/Registry.cs" Link="Registry.cs" />
    <EmbeddedResource Include="../../registry/**/*"
                      Exclude="../../registry/**/examples/**/*"
                      LogicalName="registry/%(RecursiveDir)%(Filename)%(Extension)"
                      WithCulture="false" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
