<Project Sdk="Microsoft.NET.Sdk.Razor">
  <Import Project="../VelleVersion.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BlazorVersion" Value="$(VelleBlazorVersion)" />
    <PackageReference Include="Scriban" Version="7.6.1" />
    <ProjectReference Include="../Velle.Blazor/Velle.Blazor.csproj" />
    <Compile Include="../Shared/Registry.cs" Link="Registry.cs" />
    <EmbeddedResource Include="../../registry/**/*"
                      LogicalName="registry/%(RecursiveDir)%(Filename)%(Extension)"
                      WithCulture="false" />
    <EmbeddedResource Include="Assets/**/*"
                      LogicalName="docs/assets/%(RecursiveDir)%(Filename)%(Extension)"
                      WithCulture="false" />
    <EmbeddedResource Include="Templates/*.html;Templates/*.md"
                      LogicalName="docs/templates/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../Velle.Blazor/wwwroot/**/*"
                      Exclude="../Velle.Blazor/wwwroot/lib/README.md"
                      LogicalName="blazor-assets/%(RecursiveDir)%(Filename)%(Extension)"
                      WithCulture="false" />
  </ItemGroup>
</Project>
