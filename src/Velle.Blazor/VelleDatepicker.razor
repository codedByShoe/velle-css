@using System.Text.Json

<div x-data="velleDatepicker" x-on:velle-enhanced-load.window="refresh"
     data-velle-datepicker-options="@Options" class="flex flex-col gap">
    <label for="@Id">@Label</label>
    <input type="text" id="@Id" name="@Name" value="@Value" placeholder="@Placeholder" class="input" />
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = null!;
    [Parameter, EditorRequired] public string Name { get; set; } = null!;
    [Parameter, EditorRequired] public string Label { get; set; } = null!;
    [Parameter] public string? Value { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string Type { get; set; } = "date";
    [Parameter] public string Mode { get; set; } = "single";
    [Parameter] public IReadOnlyList<string> DisabledDates { get; set; } = [];
    [Parameter] public int ShowMonths { get; set; } = 1;
    [Parameter] public string DateFormat { get; set; } = "F d, Y";
    [Parameter] public string DateTimeFormat { get; set; } = "F d, Y H:i";

    private string Options => JsonSerializer.Serialize(new
    {
        type = Type,
        mode = Mode,
        disable = DisabledDates,
        showMonths = ShowMonths,
        dateFormat = DateFormat,
        dateTimeFormat = DateTimeFormat
    });
}
