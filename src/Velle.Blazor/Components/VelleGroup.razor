@namespace Velle.Blazor

<div class="@CombinedClass" role="group" aria-label="@Label" @attributes="RootAttributes">
    @ChildContent
</div>

@code {
    /// <summary>
    /// Orientation for joined controls (defaults to <see cref="VelleOrientation.Horizontal"/>).
    /// </summary>
    [Parameter] public VelleOrientation Orientation { get; set; } = VelleOrientation.Horizontal;

    /// <summary>
    /// Accessible label applied to the <c>role="group"</c> container.
    /// </summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// Controls (buttons, inputs, toggles) joined by shared borders.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Additional CSS classes merged onto the group container.
    /// </summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Additional HTML attributes applied to the group container.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string BaseClass => Orientation == VelleOrientation.Vertical ? "group-vertical" : "group";

    private string? CombinedClass => AttributeUtilities.CombineClasses(BaseClass, Class, AdditionalAttributes);

    private IReadOnlyDictionary<string, object>? RootAttributes =>
        AttributeUtilities.Without(AdditionalAttributes, "class", "role", "aria-label");
}
