@namespace Velle.Blazor

<div class="@CombinedClass" @attributes="RootAttributes">
    @ChildContent
</div>

@code {
    /// <summary>
    /// <see cref="VelleAvatar"/> items rendered in an overlapping horizontal row.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Additional CSS classes merged onto the root <c>.avatar-group</c> container.
    /// </summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Additional HTML attributes applied to the root container.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string? CombinedClass => AttributeUtilities.CombineClasses("avatar-group", Class, AdditionalAttributes);

    private IReadOnlyDictionary<string, object>? RootAttributes =>
        AttributeUtilities.Without(AdditionalAttributes, "class");
}
