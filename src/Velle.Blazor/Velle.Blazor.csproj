<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0-alpha.1</Version>
    <Description>Velle CSS components for Blazor with Alpine.js browser behavior.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/codedbyshoe/velle-css</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.15" />
    <Content Include="../../dist/velle.css" Link="wwwroot/velle.css"
             ContentRoot="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '../../dist'))" />
    <Content Include="../../dist/adapters/datepicker.css" Link="wwwroot/datepicker.css"
             ContentRoot="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '../../dist/adapters'))" />
  </ItemGroup>
</Project>
